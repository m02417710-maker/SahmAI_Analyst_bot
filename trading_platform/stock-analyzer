{
  "name": "stock-analyzer",
  "version": "1.0.0-beta",
  "description": "Advanced Stock Analysis Platform for Egyptian Exchange",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server/index.js",
    "start": "node server/index.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "echo 'Server ready'",
    "build:client": "cd client && npm run build",
    "test": "jest --coverage",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test:e2e": "cypress run",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "production": "NODE_ENV=production node server/index.js",
    "prod:build": "npm run build && npm run start",
    "analyze": "node scripts/analyze.js",
    "backup": "node scripts/backup.js",
    "health-check": "node scripts/health-check.js",
    "precommit": "lint-staged",
    "prepush": "npm run test && npm run lint"
  },
  "keywords": [
    "stock",
    "analysis",
    "trading",
    "technical-indicators",
    "portfolio",
    "egyptian-exchange",
    "financial-analysis"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-cors": "^1.3.2",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "bull": "^4.11.5",
    "winston": "^3.11.0",
    "axios": "^1.6.2",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.45",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "stripe": "^14.10.0",
    "twilio": "^4.5.0",
    "nodemailer-sendgrid": "^1.0.3",
    "chart.js": "^4.4.0",
    "ta-lib": "^0.4.20"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "lint-staged": "^15.2.0",
    "@testing-library/react": "^14.1.2",
    "cypress": "^13.6.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "babel": "^6.23.0",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "client/*",
      "dist/*",
      "build/*",
      "coverage/*"
    ],
    "env": {
      "NODE_ENV": "development"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
